# ============================================
# Flowchat — Environment Variables (EXAMPLE)
# Copy this file to `.env.local` and fill real values.
# NEVER commit the real `.env.local` file.
# ============================================

# --- Clerk (Login / Signup) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# --- Supabase (Database) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # server-side only

# --- Razorpay (Payments) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# --- Meta / Instagram (rebuild ke time use hoga) ---
# META_APP_ID=xxxxxxxxxxxxxxx
# META_APP_SECRET=xxxxxxxxxxxxxxxx
# INSTAGRAM_APP_ID=xxxxxxxxxxxxxxx
# INSTAGRAM_APP_SECRET=xxxxxxxxxxxxxxxx
